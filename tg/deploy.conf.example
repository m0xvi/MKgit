# Конфиг развёртывания ключа. Скопируйте в deploy.conf рядом со скриптом
# (cp deploy.conf.example deploy.conf) и заполните.
#
# Приоритет: переменные окружения > этот файл. Т.е. если переменная уже
# задана в окружении (export), значение из этого файла НЕ перекроет её.

# Путь к devices.conf с хостами (IP и имена оттуда используются)
DEVICES_CONF="/home/aionis/MikroGit/devices.conf"

# Публичный ключ, который будем раздавать
KEY_FILE="/home/aionis/.ssh/mk_key.pub"

# Логин/пароль/порт для ВХОДА ПО TELNET (административный, НЕ из devices.conf)
TL_USER="admin"
TL_PASS=""
TL_PORT="23"

# Кому назначить ключ на роутерах.
# Если пусто — берётся 4-е поле (user) из devices.conf для каждого хоста.
# Если задано — ключ назначается этому пользователю на ВСЕХ хостах
# (и пользователь создаётся, если его нет).
TARGET_USER=""

# Пароль для СОЗДАВАЕМОГО пользователя (если TARGET_USER не существует).
# Пусто = случайный пароль (будет виден в логе).
NEWUSER_PASS=""

# Целевая группа прав пользователя.
#   "@current" (по умолчанию) — править ТУ группу, в которой пользователь уже
#                состоит (например forbackup): недостающие политики из
#                TARGET_POLICY добавляются, лишние не снимаются, пользователь
#                НЕ переводится в другую группу;
#   "mikrogit"   — отдельная группа с минимальными политиками; пользователя
#                из forbackup/full переведёт в неё (прежнее поведение);
#   пусто        — не менять группу, только показать текущие права в логе.
# Если пользователя на роутере ещё нет, он создаётся в TARGET_GROUP_FALLBACK
# (по умолчанию mikrogit) с политиками TARGET_POLICY.
TARGET_GROUP="@current"

# Политики группы TARGET_GROUP: недостающие ДОБАВЛЯЮТСЯ, остальные остаются.
# Минимум, достаточный для задач бота:
#   ssh        — вход по SSH;
#   read/write — конфиг, /system backup save, /system package update;
#   test       — проверка обновлений;
#   reboot     — перезагрузка после установки;
#   policy     — операции с пакетами/RouterBOOT;
#   ftp        — scp/sftp (заливка harden-скрипта и скачивание файлов);
#   sensitive  — ОБЯЗАТЕЛЬНО для .backup: файл помечен sensitive, без этой
#                политики RouterOS не отдаёт его по scp/ftp (бэкап создаётся,
#                но «не скачивается»).
TARGET_POLICY="ssh,read,write,test,reboot,policy,ftp,sensitive"

# Транспорт входа АДМИНИСТРАТОРА (TL_USER) на роутер:
#   auto   — telnet, если порт открыт, иначе ssh (по умолчанию; для роутеров,
#            где telnet отключён);
#   telnet — только telnet;
#   ssh    — только ssh (порт берётся из devices.conf, поле 3).
LOGIN_VIA="auto"

# Приватный ключ для SSH-предпроверки «ключ уже работает?».
# Если он найден и заходит на роутер — устройство пропускается (без telnet).
# По умолчанию: KEY_FILE без расширения .pub, т.е. ~/.ssh/mk_key.
KEY_PRIV="/home/aionis/.ssh/mk_key"

# SSH-предпроверка: 1 = пропускать роутеры с уже рабочим ключом (по умолч.),
# 0 = всегда заходить по telnet (то же, что флаг --force).
SSH_PROBE="1"

# Таймаут SSH-предпроверки на одно устройство, секунд.
SSH_TIMEOUT="8"

# После развёртывания скрипт заново проверяет вход по SSH и засчитывает
# устройство успешным, только если ключ реально заработал (1, по умолчанию).
# 0 = верить выводу telnet (для отладки).
SSH_VERIFY="1"
