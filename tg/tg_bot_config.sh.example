#!/bin/bash
# =============================================================================
# Telegram Bot Configuration for MikroTik Backup Bot
# =============================================================================

# --- Telegram Bot Settings ---
# IMPORTANT: Store token securely! Consider using a vault or restricted file.
export TELEGRAM_BOT_TOKEN=""
export TELEGRAM_CHAT_ID=""

# --- Paths ---
export CONFIG_FILE="/home/aionis/MikroGit/devices.conf"
export BACKUP_SCRIPT="/home/aionis/MikroGit/MikroGit.sh"
export LOG_FILE="/home/aionis/MikroGit/logs/mk_backup.log"

# --- Proxy Settings (REQUIRED for Russia) ---
# Supported types: http, socks5, socks5h
# Format: protocol://[user:pass@]host:port
#
# Examples:
#   HTTP proxy:
#     export TELEGRAM_PROXY="http://proxy.example.com:8080"
#   SOCKS5 proxy:
#     export TELEGRAM_PROXY="socks5://proxy.example.com:1080"
#   SOCKS5 with hostname resolution on proxy side:
#     export TELEGRAM_PROXY="socks5h://proxy.example.com:1080"
#   Authenticated proxy:
#     export TELEGRAM_PROXY="http://user:pass@proxy.example.com:8080"
#
# Also respected (by curl natively):
#   export HTTPS_PROXY="socks5h://proxy.example.com:1080"
#   export HTTP_PROXY="http://proxy.example.com:8080"
#   export ALL_PROXY="socks5://proxy.example.com:1080"
#
export TELEGRAM_PROXY=""

# --- Retry Settings ---
export TG_MAX_RETRIES=3
export TG_RETRY_DELAY=2
export TG_TIMEOUT=30

# --- SSH Key ---
export SSH_KEY="$HOME/.ssh/mk_key"

# =============================================================================
# RouterOS Updates (bot + tg/mk_updates.sh)
# =============================================================================
# Проверка обновлений выполняется ЧЕРЕЗ САМ РОУТЕР:
#   /system package update check-for-updates
# Требование: у роутера должен быть интернет-доступ к серверам MikroTik
# (upgrade.mikrotik.com), и SSH-пользователь из devices.conf должен иметь
# права на /system package update и /system reboot (обычно full admin).

# Канал обновлений. Варианты: stable | long-term | testing | "" (пусто —
# НЕ менять канал роутера, проверять в том канале, что настроен на самом
# устройстве). Для единообразия на всех устройствах обычно задают stable.
export UPDATE_CHANNEL="stable"

# Делать резервную копию конфигурации (MikroGit.sh --device) перед установкой
export UPDATE_BACKUP_BEFORE_APPLY="1"

# Таймаут скачивания обновления на роутере, сек
export UPDATE_DOWNLOAD_TIMEOUT="900"

# Сколько ждать возвращения устройства в SSH после перезагрузки, сек
export UPDATE_REBOOT_WAIT="600"

# Пауза между попытками опроса устройства после перезагрузки, сек
export UPDATE_REBOOT_POLL="10"

# Таймаут на одну "короткую" SSH-команду (resource print, set channel и т.п.), сек
export UPDATE_SSH_TIMEOUT="60"

# Таймаут на check-for-updates (роутер ходит на upgrade.mikrotik.com). Если
# устройство не отвечает за это время — помечается ERROR, проверка идёт дальше.
export UPDATE_CHECK_TIMEOUT="150"

# Автопроверка обновлений по расписанию (бот сам ходит на роутеры под
# пользователем из devices.conf — такие входы видны в логах роутера).
# 0 = выкл: подключения ТОЛЬКО по кнопке/команде (рекомендуется);
# 1 = вкл (не чаще одного раза в UPDATE_AUTO_INTERVAL_HOURS).
export UPDATE_AUTO_CHECK="0"

# Интервал автопроверки, часы (используется при UPDATE_AUTO_CHECK="1")
export UPDATE_AUTO_INTERVAL_HOURS="24"

# =============================================================================
# Деплой ключа/прав (кнопка «🔑 Деплой ключей/прав» + tg/mk_deploy.sh)
# =============================================================================
# Скрипт deploy_key.sh должен лежать рядом с ботом: /home/aionis/MikroGit/tg/
# (или задайте полный путь ниже).
export DEPLOY_SCRIPT="/home/aionis/MikroGit/tg/deploy_key.sh"

# Ключи MikroGit: публичный (ставится на роутер) и приватный (для SSH-проверок)
export DEPLOY_KEY_FILE="/home/aionis/.ssh/mk_key.pub"
export DEPLOY_KEY_PRIV="/home/aionis/.ssh/mk_key"

# Администраторский вход на роутер для установки ключа и выдачи прав.
# Транспорт выбирается автоматически (LOGIN_VIA=auto внутри deploy_key.sh):
# telnet, а если telnet отключён — SSH.
#   • DEPLOY_TL_PORT — это порт TELNET администратора (обычно 23);
#   • SSH-порт для входа/проверок берётся ИЗ devices.conf (3-е поле) для
#     каждого устройства отдельно — глобально его задавать не нужно.
export DEPLOY_TL_USER="admin"
export DEPLOY_TL_PORT="23"
export DEPLOY_TL_PASS=""

# Группа прав пользователя после деплоя. Вместо full — отдельная группа
# «mikrogit» с МИНИМАЛЬНО необходимыми политиками (DEPLOY_TARGET_POLICY).
# Если группы на роутере нет — deploy_key.sh создаст её сам. Политики
# существующей группы не меняются. Пусто = НЕ менять права, только показать.
export DEPLOY_TARGET_GROUP="mikrogit"
# Политики группы DEPLOY_TARGET_GROUP (используются при её создании).
# ssh,read,write,test,reboot,policy — минимум, при котором работают бэкапы и
# установка обновлений RouterOS из самого роутера. Меняйте осознанно.
export DEPLOY_TARGET_POLICY="ssh,read,write,test,reboot,policy"
# Целевой пользователь (пусто = пользователь из 4-го поля devices.conf)
export DEPLOY_TARGET_USER=""
# Пароль для СОЗДАВАЕМОГО пользователя (пусто = случайный, будет в логе)
export DEPLOY_NEWUSER_PASS=""

# 1 = SSH-предпроверка ключом (уже работает — ключ не ставим, но права
# проверяем/чиним); 0 = всегда полный прогон
export DEPLOY_SSH_PROBE="1"
# 1 = после развёртывания подтверждать результат по SSH
export DEPLOY_SSH_VERIFY="1"
# Wall-clock лимит на одно устройство, сек
export DEPLOY_ONE_TIMEOUT="600"
