# Конфиг развёртывания ключа. Скопируйте в deploy.conf рядом со скриптом
# (cp deploy.conf.example deploy.conf) и заполните.
#
# Приоритет: переменные окружения > этот файл. Т.е. если переменная уже
# задана в окружении (export), значение из этого файла НЕ перекроет её.

# Путь к devices.conf с хостами (IP и имена оттуда используются)
DEVICES_CONF="/home/aionis/MikroGit/devices.conf"

# Публичный ключ, который будем раздавать
KEY_FILE="/home/aionis/.ssh/mk_key.pub"

# Логин/пароль/порт для ВХОДА ПО TELNET (административный, НЕ из devices.conf)
TL_USER="admin"
TL_PASS=""
TL_PORT="23"

# Кому назначить ключ на роутерах.
# Если пусто — берётся 4-е поле (user) из devices.conf для каждого хоста.
# Если задано — ключ назначается этому пользователю на ВСЕХ хостах
# (и пользователь создаётся, если его нет).
TARGET_USER=""

# Пароль для СОЗДАВАЕМОГО пользователя (если TARGET_USER не существует).
# Пусто = случайный пароль (будет виден в логе).
NEWUSER_PASS=""
